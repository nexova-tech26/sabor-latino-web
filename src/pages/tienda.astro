---
import Base from '../layouts/Base.astro'
import PageHeader from '../components/PageHeader.astro'
import { Footprints, MessageCircle, Shirt, ShoppingBag, Sparkles, Tag } from '@lucide/astro'
import { categorias, productos } from '../data/productos'
import { wa } from '../data/site'

const iconos = {
  todos: null,
  ropa: Shirt,
  calzado: Footprints,
  accesorios: Tag,
}
---

<Base
  title="Tienda Oficial | Sabor Latino Villavicencio"
  description="Compra la indumentaria oficial de Sabor Latino: camisetas, calzado profesional de baile y accesorios para bailarines en Villavicencio."
>
  <PageHeader
    title="Tienda"
    highlight="Oficial"
    subtitle="Lleva el estilo de la academia contigo. Indumentaria y accesorios pensados para el alto rendimiento."
  />

  <section class="pb-24">
    <div class="container-page">
      <div class="flex flex-wrap justify-center gap-3" role="group" aria-label="Filtrar productos">
        {
          categorias.map((categoria, index) => {
            const Icono = iconos[categoria.id]
            return (
              <button
                type="button"
                class:list={['filter-btn', index === 0 && 'is-active']}
                data-category={categoria.id}
                aria-pressed={index === 0 ? 'true' : 'false'}
              >
                {Icono && <Icono class="h-4 w-4" />}
                {categoria.nombre}
              </button>
            )
          })
        }
      </div>

      <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {
          productos.map((producto, index) => (
            <article
              class="group card overflow-hidden"
              data-product-category={producto.categoria}
              data-reveal
              style={`transition-delay: ${(index % 3) * 100}ms`}
            >
              <div class="relative aspect-square overflow-hidden">
                <img
                  src={producto.imagen}
                  alt={producto.nombre}
                  class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                  width="800"
                  height="800"
                  loading="lazy"
                  decoding="async"
                />
                {producto.tag && (
                  <span class="absolute left-4 top-4 rounded bg-brand px-3 py-1 text-[0.65rem] font-bold uppercase tracking-wider">
                    {producto.tag}
                  </span>
                )}
              </div>

              <div class="p-6">
                <span class="text-[0.65rem] font-bold uppercase tracking-[0.18em] text-brand-light">
                  {producto.categoria}
                </span>
                <h2 class="mt-2 font-display text-xl">{producto.nombre}</h2>
                <p class="mt-2 text-lg font-bold">${producto.precio.toLocaleString('es-CO')}</p>

                <a
                  href={wa(`Hola, me interesa comprar: ${producto.nombre}`)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-wa mt-5 w-full"
                >
                  <ShoppingBag class="h-5 w-5" /> Pedir por WhatsApp
                </a>
              </div>
            </article>
          ))
        }
      </div>

      <p id="empty-state" class="mt-12 hidden text-center text-white/60">
        Próximamente más productos en esta categoría.
      </p>

      <div class="mt-20 grid gap-8 rounded-3xl border border-white/5 bg-surface p-8 md:grid-cols-2 md:p-10">
        <div class="flex items-center gap-5">
          <Sparkles class="h-9 w-9 shrink-0 text-brand-light" />
          <div>
            <h2 class="font-display text-xl">Calidad premium</h2>
            <p class="mt-1 text-sm text-white/60">Materiales probados en escenario.</p>
          </div>
        </div>
        <div class="flex items-center gap-5">
          <ShoppingBag class="h-9 w-9 shrink-0 text-brand-light" />
          <div>
            <h2 class="font-display text-xl">Entrega en academia</h2>
            <p class="mt-1 text-sm text-white/60">Recoge tu pedido en nuestra sede.</p>
          </div>
        </div>
      </div>

      <div class="mt-12 text-center">
        <p class="text-sm text-white/55">
          ¿No encuentras lo que buscas? Escríbenos y te ayudamos.
        </p>
        <a
          href={wa('Hola, quisiera consultar por un producto de la tienda')}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-outline mt-4"
        >
          Consultar disponibilidad <MessageCircle class="h-4 w-4" />
        </a>
      </div>
    </div>
  </section>
</Base>

<script>
  const buttons = Array.from(document.querySelectorAll('[data-category]'))
  const cards = Array.from(document.querySelectorAll('[data-product-category]'))
  const emptyState = document.getElementById('empty-state')

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const category = button.dataset.category

      buttons.forEach((item) => {
        const active = item === button
        item.setAttribute('aria-pressed', String(active))
        item.classList.toggle('is-active', active)
      })

      let visible = 0
      cards.forEach((card) => {
        const show = category === 'todos' || card.dataset.productCategory === category
        card.classList.toggle('hidden', !show)
        if (show) visible += 1
      })

      emptyState?.classList.toggle('hidden', visible > 0)
    })
  })
</script>
